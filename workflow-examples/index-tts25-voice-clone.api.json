{
  "1": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "__HYDRA_REFERENCE_AUDIO__"
    }
  },
  "2": {
    "class_type": "TopTTS25ModelLoader",
    "inputs": {
      "model_directory": "IndexTTS-2.5",
      "device": "cuda",
      "precision": "bf16",
      "load_emotion_text_model": false,
      "use_cuda_kernel": false,
      "use_torch_compile": false
    }
  },
  "3": {
    "class_type": "TopTTS25Synthesize",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "text": "__HYDRA_TEXT__",
      "reference_audio": [
        "1",
        0
      ],
      "language": "ZH",
      "duration_factor": 1,
      "emotion_strength": 1,
      "seed": 0,
      "emotion_text": "",
      "randomize_emotion": false,
      "interval_silence_ms": 200,
      "max_text_tokens_per_segment": 120,
      "temperature": 0.8,
      "top_p": 0.8,
      "top_k": 30,
      "num_beams": 3,
      "repetition_penalty": 10,
      "max_mel_tokens": 1500,
      "text_normalization": true
    }
  },
  "4": {
    "class_type": "SaveAudioMP3",
    "inputs": {
      "audio": [
        "3",
        0
      ],
      "filename_prefix": "hydra-inferworks/index-tts25/output",
      "quality": "320k"
    }
  },
  "5": {
    "class_type": "TopTTS25UnloadModel",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "after": [
        "3",
        0
      ]
    }
  },
  "6": {
    "class_type": "TopTTS25EmotionVector",
    "inputs": {
      "happy": 0,
      "angry": 0,
      "sad": 0,
      "afraid": 0,
      "disgusted": 0,
      "melancholic": 0,
      "surprised": 0,
      "calm": 0
    }
  }
}

