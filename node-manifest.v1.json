{
  "contract_version": "hydra_inferworks_node_manifest.v1",
  "package": "comfyui-hydra-inferworks",
  "version": "1.2.3",
  "minimum_comfyui_version": "0.30.0",
  "inference_profiles": "inference-profiles.v1.json",
  "asr_model_attestations": "asr-model-attestations.v1.json",
  "capabilities": [
    {
      "key": "tts",
      "provider": "IndexTeam/IndexTTS-2.5",
      "model_weights_bundled": false,
      "nodes": [
        "TopTTS25ModelLoader",
        "TopTTS25EmotionVector",
        "TopTTS25Synthesize",
        "TopTTS25UnloadModel"
      ]
    },
    {
      "key": "asr",
      "provider": "Qwen/Qwen3-ASR-1.7B + Qwen/Qwen3-ForcedAligner-0.6B",
      "model_weights_bundled": false,
      "nodes": [
        "HydraQwen3ASRModelLoader",
        "HydraQwen3LongAsrTranscribe",
        "HydraQwen3ForcedAlign",
        "HydraTranscriptReceipt"
      ]
    },
    {
      "key": "heygem",
      "provider": "HeyGem-compatible service",
      "service_bundled": false,
      "nodes": [
        "HydraHeyGemLongformAvatar"
      ]
    }
  ],
  "compatibility": {
    "preserved_class_types": [
      "TopTTS25ModelLoader",
      "TopTTS25EmotionVector",
      "TopTTS25Synthesize",
      "TopTTS25UnloadModel",
      "HydraQwen3ASRModelLoader",
      "HydraQwen3LongAsrTranscribe",
      "HydraQwen3ForcedAlign",
      "HydraTranscriptReceipt",
      "HydraHeyGemLongformAvatar"
    ],
    "supersedes_packages": [
      "ComfyUI-Top-TTS",
      "ComfyUI-Hydra-Audio",
      "ComfyUI-Hydra-HeyGem"
    ],
    "hydra_environment_aliases_are_legacy_fallbacks": true
  },
  "portability": {
    "requires_hydramatrix_runtime": false,
    "heygem_endpoint_requires_explicit_input_or_environment": true,
    "heygem_endpoint_has_implicit_port": false,
    "shared_storage_uses_separate_comfyui_and_service_namespaces": true,
    "docker_lifecycle_requires_explicit_container_name": true,
    "service_gpu_release_requires_explicit_route": true
  },
  "invariants": [
    "capability_import_failures_are_isolated",
    "index_tts_2_5_inference_is_local_and_offline_after_model_setup",
    "tts_worker_cleanup_is_deterministic",
    "inference_precision_quantization_and_acceleration_are_recorded",
    "runtime_evidence_is_derived_from_executed_models_not_caller_strings",
    "production_asr_receipts_require_exact_official_model_attestations",
    "production_asr_alignment_uses_only_model_native_80ms_timestamp_bins",
    "asr_alignment_uses_global_max_logit_monotonic_decoding_not_timestamp_repair",
    "asr_timestamp_interpolation_scaling_clamping_and_estimation_fail_closed",
    "unverified_quantization_profiles_fail_closed",
    "asr_long_audio_timestamps_restore_one_global_timeline",
    "locked_script_alignment_fails_closed_on_anchor_mismatch",
    "heygem_service_endpoint_is_runtime_configurable",
    "heygem_service_endpoint_has_no_project_specific_default",
    "heygem_shared_storage_namespaces_are_explicit",
    "hydramatrix_runtime_is_not_required",
    "long_video_output_remains_file_backed",
    "caller_job_identity_correlates_prompt_receipt_and_artifact",
    "containerized_comfyui_releases_heygem_gpu_via_service_api_without_docker_control",
    "heygem_gpu_release_receipts_fail_closed_on_provider_cleanup_errors",
    "receipts_bind_artifacts_to_sha256"
  ]
}
